# Copie para .env e preencha com os valores do seu projeto Supabase
# (Settings > API no painel do Supabase).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Slug da paróquia padrão selecionada no primeiro acesso (ver tabela parishes)
EXPO_PUBLIC_DEFAULT_PARISH_SLUG=nossa-senhora-aparecida

# Usado apenas nas Edge Functions (configurar em supabase secrets set, não aqui)
# SUPABASE_SERVICE_ROLE_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# LITURGY_API_URL=
# BIBLE_API_URL=
# BIBLE_API_KEY=
