# Copie para supabase/functions/.env e use: supabase secrets set --env-file supabase/functions/.env
SITE_URL=https://movimenta.com.br

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_IDS=price_mensal,price_anual
STRIPE_TRIAL_DAYS=7

# RevenueCat (compras na App Store e no Google Play)
REVENUECAT_SECRET_API_KEY=sk_...
REVENUECAT_WEBHOOK_AUTH=Bearer um-segredo-longo-que-voce-inventa
REVENUECAT_ENTITLEMENT=premium

# Cloudflare Stream
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=
CF_STREAM_KEY_ID=
CF_STREAM_KEY_JWK=
CF_STREAM_WEBHOOK_SECRET=

# Firebase (conta de serviço em base64: base64 -w0 service-account.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=
