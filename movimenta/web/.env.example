# Copie para .env.local (desenvolvimento) e cadastre as mesmas chaves na Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_APP_NAME=Movimenta
# Planos exibidos em /assinar (os IDs precisam estar em STRIPE_PRICE_IDS das Edge Functions)
NEXT_PUBLIC_PRICE_MENSAL_ID=price_xxx
NEXT_PUBLIC_PRICE_MENSAL_LABEL=R$ 39,90/mês
NEXT_PUBLIC_PRICE_ANUAL_ID=price_yyy
NEXT_PUBLIC_PRICE_ANUAL_LABEL=R$ 358,80/ano (R$ 29,90/mês)
# Links das lojas (opcional)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
