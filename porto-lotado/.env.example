# Copie para .env e preencha. Sem valores, o app usa os IDs de TESTE do Google e a loja simulada.

# AdMob: IDs dos blocos de anúncio (console do AdMob > Apps > Blocos de anúncios)
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_INTERSTITIAL_IOS=
# true enquanto estiver testando. NUNCA clique em anúncios reais do próprio app.
VITE_ADMOB_TESTING=true

# RevenueCat: chaves públicas do SDK (Project settings > API keys)
VITE_REVENUECAT_ANDROID=
VITE_REVENUECAT_IOS=
