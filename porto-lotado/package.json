{
  "name": "porto-lotado",
  "version": "0.1.0",
  "description": "Porto Lotado: quebra-cabeça de organizar contêineres por cor",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
